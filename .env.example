# Copy to .env.local and fill in. Never commit real values.

# Database (MySQL 8). App user: limited rights, used by the running app.
DATABASE_URL=mysql://portal_app:change-me@localhost:3306/nets_portal
# Admin user: migrations and seeding only. Never used by the running app.
DATABASE_ADMIN_URL=mysql://portal_admin:change-me@localhost:3306/nets_portal
# true for the hosted database (TLS 1.2+, certificate verified), false for local
DATABASE_SSL=false
# Optional, with DATABASE_SSL=true: the provider's CA certificate (the PEM text, or a path to the .pem file)
DATABASE_SSL_CA=
# Optional: connections per server instance (default 3 in production, 10 otherwise)
DB_CONNECTION_LIMIT=
# Separate database for integration tests (it gets wiped)
TEST_DATABASE_URL=mysql://portal_app:change-me@localhost:3306/nets_portal_test
# Admin user on the test database: runs migrations and clears tables in tests
TEST_DATABASE_ADMIN_URL=mysql://portal_admin:change-me@localhost:3306/nets_portal_test

# Optional: the NETS Assistant shows "not set up yet" without it.
ANTHROPIC_API_KEY=
# Assistant: rules = no AI (MVP default), ai = uses Claude (needs ANTHROPIC_API_KEY)
ASSISTANT_MODE=rules

# Show one-click demo logins on /login (prototype/demo deployments only)
DEMO_MODE=true
# Password for the demo logins created by `npm run seed`
DEMO_PASSWORD=change-me

# Reserved for the Phase 1 scheduled jobs (no cron route exists yet, nothing reads this today)
CRON_SECRET=change-me
